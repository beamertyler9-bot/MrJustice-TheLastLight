const ALIASES = {"moth": "starwing_moth", "hare": "fernhare", "deer": "glimmerstag", "fox": "mistrunner_fox", "bird": "dawnbell_songbird", "boar": "mossbrow_boar", "ironhide_boar": "wild_boar", "the_bellkeeper": "bellkeeper", "cola_slime": "cola_sloshback"}
static var profiles: Dictionary = {}
static func for_species(species: String) -> Dictionary:
	var id: String = ALIASES.get(species, species)
	if not DATA.has(id): id = "moss_guardian"
	if not profiles.has(id):
		var row: Array = DATA[id]
		profiles[id] = {"id": id, "gait": row[0], "idle": row[1], "attack": row[2], "rate": row[3], "stride": row[4], "weight": row[5], "head": row[6], "tail": row[7], "accent": row[8]}
	return profiles[id]
